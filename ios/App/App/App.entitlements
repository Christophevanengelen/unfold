<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>aps-environment</key>
	<string>development</string>
	<!-- Le meme groupe que FavorableWidget.entitlements. Les deux cibles
	     doivent le declarer a l identique : sinon UserDefaults(suiteName:)
	     rend nil, en silence, des deux cotes. -->
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.day.favorable.app</string>
	</array>
	<!-- Universal Links : sans cette cle, un lien https://favorable.day/app/invite/join
	     ouvre Safari au lieu de l app, meme avec le fichier AASA en place cote
	     serveur (app/.well-known/apple-app-site-association/route.ts). Ajoutee
	     ici a la main ; Xcode doit encore la reprendre dans Signing &
	     Capabilities ("Associated Domains") pour qu elle entre dans le profil
	     de provisionnement — geste reserve au compte developpeur Apple de
	     Christophe, aucune valeur reservee ici : "favorable.day" est le vrai
	     domaine de production. -->
	<key>com.apple.developer.associated-domains</key>
	<array>
		<string>applinks:favorable.day</string>
	</array>
</dict>
</plist>
