# ══════════════════════════════════════════════════════════════════════════
# Favorable — variables d'environnement
#
# Copier ce fichier en `.env.local` et le remplir. `.env.local` est ignore par
# git ; ce gabarit-ci est suivi, donc il ne doit JAMAIS contenir de vraie clef.
#
# Ce fichier a ete regenere le 01/09/2026 a partir de tous les
# `process.env.X` du code. Il en manquait 38, dont NEXT_PUBLIC_SUPABASE_ANON_KEY
# sans laquelle l'app ne demarre pas : quelqu'un qui clonait le depot passait la
# soiree a deviner ce qu'on attendait de lui.
#
# Un controle verifie desormais que ce fichier reste complet :
#   node scripts/verifier-env-exemple.mjs
# ══════════════════════════════════════════════════════════════════════════


# ─────────────────────────────────────────────────────────────────────────
# 1. LE MINIMUM POUR LANCER `npm run dev`
#    Sans ces cinq-la, rien ne demarre.
# ─────────────────────────────────────────────────────────────────────────

# Supabase — profils, connexions, jetons de notification, compteurs d'usage.
# lib/db.ts, lib/supabase-auth.ts
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""

# Acces psql direct a la meme base. Sert aux migrations et aux verifications.
#   psql "$SUPABASE_DB_URL" -c "select count(*) from profiles;"
SUPABASE_DB_URL=""

# OpenAI — facture sur une clef personnelle. Chaque route /api/openai/* la
# depense. Le garde-fou ci-dessous borne la casse.
OPENAI_API_KEY=""


# ─────────────────────────────────────────────────────────────────────────
# 2. LE MOTEUR D'ASTROLOGIE
#    L'API de Marie-Ange. C'est elle qui rend les periodes.
# ─────────────────────────────────────────────────────────────────────────

# Adresse de base des appels moteur. Vide = l'app appelle son propre domaine,
# ce qui est le bon reglage sur le web. Dans l'app native l'origine est
# `capacitor://localhost`, donc cette valeur DOIT etre remplie pour le build
# natif. Voir lib/api-client.ts.
NEXT_PUBLIC_API_BASE=""

# "mock" pour travailler sans le moteur, sur des donnees d'exemple.
# Tout autre valeur (ou vide) appelle le vrai moteur. lib/momentum-api.ts
NEXT_PUBLIC_API_MODE=""

# Pose a "true" par scripts/build-native.sh. Ne pas remplir a la main.
NEXT_PUBLIC_NATIVE=""


# ─────────────────────────────────────────────────────────────────────────
# 3. LE GARDE-FOU DE DEPENSE IA (lib/ai-guard.ts)
#    Tous optionnels : les valeurs par defaut du code s'appliquent si vide.
#    Demande supabase/008_ai_guard.sql.
# ─────────────────────────────────────────────────────────────────────────

# Plafond quotidien pour tout le site. C'est celui qui borne reellement la
# facture.
AI_LIMIT_GLOBAL_PER_DAY="2000"
# Par adresse IP, par heure. Empeche une machine de boucler.
AI_LIMIT_IP_PER_HOUR="30"
# Par appelant (compte connecte, ou session anonyme), par jour.
AI_LIMIT_CALLER_PER_DAY="20"

# Signe le cookie de session anonyme et le marqueur d'appel interne.
# Retombe sur SUPABASE_SERVICE_ROLE_KEY si vide. Jamais envoye au navigateur.
API_SESSION_SECRET=""
INTERNAL_CALL_SECRET=""

# Developpement local uniquement : "true" desactive le garde-fou. Ignore en
# production.
AI_GUARD_DISABLED=""

# Developpement local uniquement : "true" saute la verification de compte sur
# /api/openai/personalize.
DEV_BYPASS_AUTH=""


# ─────────────────────────────────────────────────────────────────────────
# 4. PAIEMENT
#    Rien de tout ceci n'est necessaire pour developper l'app.
# ─────────────────────────────────────────────────────────────────────────

# Stripe — le paiement du site web.
STRIPE_SECRET_KEY=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""
STRIPE_PRICE_MONTHLY=""
STRIPE_PRICE_ANNUAL=""
# L'offre « a vie » a ete retiree de l'ecran le 01/09/2026. Le prix reste ici
# tant que la decision de la supprimer n'est pas prise. Voir PLAYBOOK.md.
STRIPE_PRICE_LIFETIME=""
STRIPE_WEBHOOK_SECRET=""

# RevenueCat — les achats dans l'app iOS. Tant que la clef est vide,
# lib/achats.ts reste inerte : aucun appel au SDK, aucun ecran d'achat.
NEXT_PUBLIC_REVENUECAT_IOS_KEY=""
REVENUECAT_API_KEY=""
REVENUECAT_WEBHOOK_SECRET=""

# Polar — prestataire de paiement alternatif. lib/billing/polar.ts
POLAR_ACCESS_TOKEN=""
POLAR_WEBHOOK_SECRET=""
POLAR_PRODUCT_MONTHLY=""
POLAR_PRODUCT_ANNUAL=""
# "sandbox" ou "production".
POLAR_SERVER=""

# Codes d'acces au Lifetime Chart. Liste separee par des virgules. Voir le
# registre : ils sont verifies COTE CLIENT, donc lisibles par n'importe qui.
# Codes d acces au Lifetime Chart. Liste separee par des virgules.
# SANS prefixe NEXT_PUBLIC_ : la verification se fait cote serveur, dans
# app/api/coupons/verifier. Avec le prefixe, la liste partait dans le paquet
# javascript de chaque visiteur — n importe qui pouvait lire tous les codes.
CHART_COUPONS=""

# Developpement local uniquement : "true" donne l'acces premium sans compte ni
# paiement. lib/premium-gate.ts
NEXT_PUBLIC_DEV_FORCE_PREMIUM=""


# ─────────────────────────────────────────────────────────────────────────
# 5. NOTIFICATIONS (APNs)
#    Production uniquement. Le cron n'envoie rien sans elles.
# ─────────────────────────────────────────────────────────────────────────

# Clef .p8 d'Apple, sautée de ligne comprise (les \n litteraux sont acceptes).
APNS_PRIVATE_KEY=""
APNS_KEY_ID=""
APNS_TEAM_ID=""
APNS_BUNDLE_ID="day.favorable.app"

# Protege /api/cron/push. Vercel l'envoie en en-tete Authorization.
CRON_SECRET=""


# ─────────────────────────────────────────────────────────────────────────
# 6. APP STORE CONNECT
#    Pour les scripts de livraison (scripts/apple.mjs). Pas pour developper.
# ─────────────────────────────────────────────────────────────────────────

APPLE_APP_ID=""
APPLE_ISSUER_ID=""
APPLE_KEY_ID=""
# Nom de l'entree dans le trousseau macOS qui contient la clef privee.
APPLE_KEY_SERVICE=""


# ─────────────────────────────────────────────────────────────────────────
# 7. BASES HERITEES
#    Lues par lib/astrolearn-db.ts. Laisser vide si tu ne sais pas ce que
#    c'est : le code s'en passe.
# ─────────────────────────────────────────────────────────────────────────

# Mot de passe de /api/admin/grant-premium. Sans lui la route refuse tout, ce
# qui est le bon comportement : ne le remplir que pour s'en servir.
ADMIN_PASSWORD=""

# Repli de calcul local, volontairement optionnel : lib/astrolearn-calculator.ts
# ne s'active QUE si ce chemin est renseigne. Laisser vide.
CALCULATOR_DIR=""

# Ancienne adresse de l'API spirituelle. Doublon de FULL_SUITE_SPIRITUAL_API_URL.
SPIRITUAL_API_URL=""

ASTROLEARN_DATABASE_URL=""
BUBBLE_DATABASE_URL=""
ASTROLEARN_ADMIN_EMAIL=""
ASTROLEARN_ADMIN_PASSWORD=""
ASTROLEARN_ADMIN_PERSON_ID=""
FULL_SUITE_SPIRITUAL_API_URL=""
LANDING_DB_TRANSLATIONS=""

# Reste d'un ancien projet Vite. Lu en repli par deux routes OpenAI, qui
# devraient toutes lire OPENAI_API_KEY. A retirer du code, pas a remplir.
VITE_OPENAI_API_KEY=""


# ─────────────────────────────────────────────────────────────────────────
# 8. SITE PUBLIC ET TESTS
# ─────────────────────────────────────────────────────────────────────────

# Sert au SEO, aux balises Open Graph et au sitemap.
NEXT_PUBLIC_BASE_URL="https://favorable.day"

# Affiche un vrai signal calcule sur la page d'accueil, au lieu d'un exemple.
NEXT_PUBLIC_LANDING_REAL_SIGNAL=""

# Tests de bout en bout contre un environnement deploye. Les 21 parcours de
# `npm run test:e2e` n'en ont PAS besoin : ils tournent en local sur le port
# 3333 avec un moteur simule.
E2E_BASE_URL=""
E2E_SUPABASE_URL=""
E2E_SUPABASE_ANON_KEY=""
E2E_SUPABASE_SERVICE_ROLE_KEY=""
