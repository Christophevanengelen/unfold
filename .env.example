# Supabase
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# OpenAI — billed to a personal key. Every /api/openai/* route spends it.
# It was never listed here even though the code reads it, which made the cost
# easy to forget. Listed now on purpose.
OPENAI_API_KEY=""

# ── AI budget guard (lib/ai-guard.ts) ───────────────────────────────
# Bounds on the routes that spend OPENAI_API_KEY. All optional: the defaults
# in the code apply when these are empty. Requires supabase/008_ai_guard.sql.
#
# Hard daily ceiling for the whole site. The one that actually caps the bill.
AI_LIMIT_GLOBAL_PER_DAY="2000"
# Per IP address, per hour. Stops one machine from looping.
AI_LIMIT_IP_PER_HOUR="30"
# Per caller (signed-in user, or anonymous session cookie), per day.
AI_LIMIT_CALLER_PER_DAY="20"
# Key used to sign the anonymous session cookie and the internal loopback
# marker. Falls back to SUPABASE_SERVICE_ROLE_KEY when empty. Never sent to
# the browser.
API_SESSION_SECRET=""
INTERNAL_CALL_SECRET=""
# Local development only: "true" skips the guard entirely. Ignored in production.
AI_GUARD_DISABLED=""

# Public URL (used for SEO, OG tags, sitemap)
NEXT_PUBLIC_BASE_URL="https://unfold.app"

# Admin auth (optional — protects /admin routes)
ADMIN_PASSWORD=""

# Astrology calculators (Full Suite spiritual API, PHP)
# Base URL of the remote PHP API used by every /api/astrolearn/* route and by the
# report routes (Spirit Wave, Birthday Graph, Lifetime chart).
# Endpoints are appended to this base, e.g. <base>/api/zodiacal-releasing
# Defaults to https://ai.zebrapad.io/full-suite-spiritual-api when unset.
# FULL_SUITE_SPIRITUAL_API_URL is accepted as a legacy alias.
SPIRITUAL_API_URL="https://ai.zebrapad.io/full-suite-spiritual-api"

# Local dev escape hatch (optional — leave EMPTY on Vercel and on macOS).
# Absolute path to a local checkout of the full-suite-api repo containing
# calculator_wrapper.js. When set, calculator calls fall back to running that
# wrapper through a POSIX shell if the remote API is unreachable.
# When unset (the default), no local process is ever spawned.
CALCULATOR_DIR=""

# ── Tests de bout en bout (Playwright) ──────────────────────────────────────
# Aucune valeur ici. Chacun renseigne les siennes en local.
# Ne JAMAIS recopier une cle dans e2e/ : le depot est public.
E2E_BASE_URL=
E2E_SUPABASE_URL=
E2E_SUPABASE_SERVICE_ROLE_KEY=
E2E_SUPABASE_ANON_KEY=
